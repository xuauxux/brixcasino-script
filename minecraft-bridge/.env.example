# Copy to .env in this folder (or set the same keys in the project .env).
# Nothing here leaves your machine except the site itself.

# Where the site runs.
MC_APP_URL=http://127.0.0.1:8000

# Must match MC_BRIDGE_SECRET in the site's .env exactly (at least 16 chars).
# Generate one with: php -r "echo bin2hex(random_bytes(32));"
MC_BRIDGE_SECRET=

# The game server the bot joins.
MC_SERVER_HOST=play.donutsmp.net
MC_SERVER_PORT=25565
# Leave empty to let mineflayer ask the server for its version.
MC_SERVER_VERSION=

# The bot account (the IGN players /pay to). For a Microsoft Java account put
# the account email here and approve the device-code link the first run prints.
# The token cache lands in this folder: keep it out of version control.
# Minecraft name of the account the bot runs. Add that account in the admin
# panel (Admin > DonutSMP > Bot accounts) with its Microsoft email + password;
# the bridge fetches those over the signed API. MC_BOT_AUTH / MC_BOT_PASSWORD
# below are only a fallback when the panel has no credentials stored.
MC_BOT_USERNAME=
MC_BOT_AUTH=microsoft
MC_BOT_PASSWORD=

# Optional: the command that prints the bot's own balance in game (e.g. /bal).
# When set, the bot reads the reply and the site's admin panel shows it live.
# Leave empty if you do not know the command: the float is still tracked from
# deposits and payouts.
MC_BALANCE_COMMAND=
